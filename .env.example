# Copy this file to .env and replace the values with your own.
# .env is listed in .gitignore, so it is never committed. Do not put real values in this file.

# --- BigQuery (Portfolio Project 9) ---------------------------------------
# Your Google Cloud project ID (top-left of the BigQuery console), e.g. my-training-123456
GCP_PROJECT_ID=your-project-id
BQ_DATASET=phase8_training
BQ_TABLE=supply_chain_orders
# Must match the location of your dataset if it already exists (US, EU, europe-west2, ...)
BQ_LOCATION=US
# WRITE_TRUNCATE replaces the table each run; WRITE_APPEND adds rows
BQ_WRITE_MODE=WRITE_TRUNCATE

# --- AI executive brief (Portfolio Project 10) ----------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
